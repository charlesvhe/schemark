{
  "$schema": "../../schemark.schema.json",
  "strict": true,
  "directories": {
    "sprint": {
      "pattern": "^(?<name>(?<start>\\d{8})-(?<end>\\d{8})-.+)$",
      "sprint": "${name}",
      "sprint_start": { "type": "string", "format": "date", "value": "${start}" },
      "sprint_end": { "type": "string", "format": "date", "value": "${end}" },
      "files": {
        "readme": {
          "pattern": "^README\\.md$",
          "required": true,
          "type": "sprint_readme",
          "frontmatter": {
            "properties": {
              "goals": {
                "type": "array",
                "items": { "type": "string" },
                "minItems": 1
              },
              "assignee": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["进行中", "完成", "取消"]
              }
            },
            "required": ["goals", "owner", "status"]
          }
        },
        "task": {
          "pattern": "^(?<id>T\\d{4})-(?<title>.+)\\.md$",
          "type": "task",
          "id": { "type": "string", "pattern": "^T\\d{4}$", "value": "${id}" },
          "title": "${title}",
          "frontmatter": {
            "properties": {
              "assignee": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["进行中", "完成", "取消"]
              },
              "priority": { "type": "string", "enum": ["高", "中", "低"] },
              "hours": { "type": "number", "minimum": 0 },
              "tags": { "type": "array", "items": { "type": "string" } },
              "depends-on": {
                "type": "array",
                "items": { "type": "string", "pattern": "^T\\d{4}$" }
              }
            },
            "required": ["assignee", "status", "priority"]
          }
        },
        "bug": {
          "pattern": "^(?<id>B\\d{4})-(?<title>.+)\\.md$",
          "type": "bug",
          "id": { "type": "string", "pattern": "^B\\d{4}$", "value": "${id}" },
          "title": "${title}",
          "frontmatter": {
            "properties": {
              "reporter": { "type": "string" },
              "assignee": { "type": "string" },
              "critical": {
                "type": "string",
                "enum": ["高", "中", "低", "阻塞"]
              },
              "status": {
                "type": "string",
                "enum": ["进行中", "完成", "取消"]
              },
              "fixed-at": { "type": "string", "format": "date" },
              "tags": { "type": "array", "items": { "type": "string" } },
              "ref-task": {
                "type": "array",
                "items": { "type": "string", "pattern": "^T\\d{4}$" }
              }
            },
            "required": ["reporter", "critical", "status"]
          }
        }
      }
    },
    "archive": {
      "pattern": "^archive$",
      "type": "archive"
    }
  },
  "files": {
    "readme": {
      "pattern": "^README\\.md$",
      "type": "root_readme"
    }
  }
}
